# Copy this file to .env for local development.
# On Vercel, set these in Project Settings -> Environment Variables.

# Secret key for the reset link: /api/reset?key=YOUR_KEY
ADMIN_KEY=change-me-to-something-long-and-random

# Upstash Redis (remembers her pick on every device).
# Optional locally: without these, the pick is saved in .data/state.json.
# Required on Vercel. Adding Upstash through the Vercel marketplace sets these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gmail that sends you the emails. Needs 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords
# Optional locally: without these, emails are printed in the terminal instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where to send the emails. Defaults to GMAIL_USER.
NOTIFY_TO=
